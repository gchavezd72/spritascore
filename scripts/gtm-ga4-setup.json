{
  "container_id": "GTM-NDXVZKB3",
  "site": "https://spritascore.com",
  "notes": "Import manually in tagmanager.google.com. Replace G-PET5JPXKYG with your GA4 Measurement ID.",
  "variables": [
    {
      "name": "DLV - ga4_event_name",
      "type": "Data Layer Variable",
      "key": "ga4_event_name"
    },
    {
      "name": "DLV - calculator_id",
      "type": "Data Layer Variable",
      "key": "calculator_id"
    },
    {
      "name": "DLV - lead_source",
      "type": "Data Layer Variable",
      "key": "lead_source"
    },
    { "name": "DLV - locale", "type": "Data Layer Variable", "key": "locale" },
    { "name": "DLV - lead_type", "type": "Data Layer Variable", "key": "lead_type" },
    {
      "name": "DLV - sector",
      "type": "Data Layer Variable",
      "key": "sector"
    },
    {
      "name": "DLV - score",
      "type": "Data Layer Variable",
      "key": "score"
    },
    {
      "name": "DLV - risk_level",
      "type": "Data Layer Variable",
      "key": "riskLevel"
    }
  ],
  "triggers": [
    { "name": "CE - generate_lead", "type": "Custom Event", "events": ["lead_submitted", "software_score_form_submit", "euaiact_form_submit", "audit_scope_request"] },
    { "name": "CE - calculator_started", "type": "Custom Event", "events": ["calculator_started", "software_score_start", "euaiact_start"] },
    { "name": "CE - calculator_completed", "type": "Custom Event", "events": ["calculator_completed", "software_score_completed", "euaiact_completed"] },
    { "name": "CE - file_download", "type": "Custom Event", "events": ["report_downloaded", "software_score_pdf_download"] },
    { "name": "CE - cta_clicked", "type": "Custom Event", "event": "cta_clicked" },
    { "name": "CE - software_score_completed", "type": "Custom Event", "event": "software_score_completed" }
  ],
  "tags": [
    {
      "name": "GA4 - Configuration",
      "type": "Google Tag",
      "measurement_id": "G-PET5JPXKYG",
      "trigger": "Initialization - All Pages",
      "consent": "analytics_storage"
    },
    {
      "name": "GA4 - Event calculator_started",
      "type": "GA4 Event",
      "measurement_id": "G-PET5JPXKYG",
      "event_name": "calculator_started",
      "trigger": "CE - calculator_started",
      "parameters": {
        "calculator_id": "{{DLV - calculator_id}}",
        "locale": "{{DLV - locale}}"
      }
    },
    {
      "name": "GA4 - Event calculator_completed",
      "type": "GA4 Event",
      "measurement_id": "G-PET5JPXKYG",
      "event_name": "calculator_completed",
      "trigger": "CE - calculator_completed",
      "parameters": {
        "calculator_id": "{{DLV - calculator_id}}",
        "locale": "{{DLV - locale}}",
        "score": "{{DLV - score}}",
        "risk_level": "{{DLV - risk_level}}"
      }
    },
    {
      "name": "GA4 - Conversion generate_lead",
      "type": "GA4 Event",
      "measurement_id": "G-PET5JPXKYG",
      "event_name": "generate_lead",
      "trigger": "CE - generate_lead",
      "parameters": {
        "calculator_id": "{{DLV - calculator_id}}",
        "locale": "{{DLV - locale}}",
        "lead_source": "{{DLV - lead_source}}",
        "lead_type": "{{DLV - lead_type}}"
      },
      "mark_as_conversion": true
    }
  ],
  "dataLayer_events": [
    "calculator_started",
    "calculator_completed",
    "lead_submitted",
    "report_downloaded",
    "cta_clicked",
    "software_score_view",
    "software_score_start",
    "software_score_question_answered",
    "software_score_completed",
    "software_score_pdf_download",
    "software_score_assessment_click",
    "software_score_form_submit",
    "euaiact_start",
    "euaiact_completed",
    "euaiact_form_submit",
    "audit_scope_request",
    "consent_update"
  ]
}
